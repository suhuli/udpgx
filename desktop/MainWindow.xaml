<Window x:Class="NorthLink.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NorthLink" Width="1180" Height="790" MinWidth="1000" MinHeight="660" WindowStartupLocation="CenterScreen" Icon="northlink.ico">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="207"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#0C171E" BorderBrush="#24373F" BorderThickness="0,0,1,0">
   <Grid Margin="18,27,18,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="10,0,0,36">
     <StackPanel Orientation="Horizontal"><Grid Width="32" Height="30" Margin="0,0,10,0"><Rectangle Width="21" Height="12" RadiusX="6" RadiusY="6" Stroke="#85E6C5" StrokeThickness="3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,3,0,0"/><Rectangle Width="21" Height="12" RadiusX="6" RadiusY="6" Stroke="#65A9D1" StrokeThickness="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,3"/></Grid><TextBlock Text="NorthLink" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
     <TextBlock Text="两端之间，直接相连。" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="1">
     <Button x:Name="NavOverview" Tag="0" Click="Nav_Click" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" Margin="0,0,13,0"/><TextBlock Text="连接工作台"/></StackPanel></Button>
     <Button x:Name="NavServices" Tag="1" Click="Nav_Click" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE968;" Margin="0,0,13,0"/><TextBlock x:Name="NavServiceLabel" Text="服务管理"/></StackPanel></Button>
     <Button x:Name="NavSettings" Tag="2" Click="Nav_Click" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Margin="0,0,13,0"/><TextBlock Text="连接配置"/></StackPanel></Button>
     <Button x:Name="NavLogs" Tag="3" Click="Nav_Click" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" Margin="0,0,13,0"/><TextBlock Text="运行日志"/></StackPanel></Button>
    </StackPanel>
    <StackPanel Grid.Row="3" Margin="9,0,0,0"><Border Background="#19392F" CornerRadius="5" Padding="9,6" HorizontalAlignment="Left"><TextBlock Text="●  仅直连 · 无中转" FontSize="11" Foreground="#85E6C5"/></Border><TextBlock x:Name="SidebarMode" Style="{StaticResource Hint}" Text="提供端 / PROVIDER" Margin="0,13,0,1"/><TextBlock Text="v0.1.0  ·  Windows x64" Style="{StaticResource Hint}" FontSize="10"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="30,27,30,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,23"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="PageTitle" Text="连接工作台" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="本地服务，点对点抵达。" Style="{StaticResource Hint}" Margin="0,7,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="StopButton" Content="停止" Click="Stop_Click" Margin="0,0,10,0" IsEnabled="False"/><Button x:Name="StartButton" Content="启动连接" Click="Start_Click" Style="{StaticResource PrimaryButton}"/></StackPanel>
   </Grid>
   <Border x:Name="NoticeBar" Grid.Row="1" Background="#26342B" BorderBrush="#4B5C39" BorderThickness="1" CornerRadius="7" Padding="12,9" Margin="0,0,0,16" Visibility="Collapsed"><DockPanel><Button Content="×" DockPanel.Dock="Right" Click="DismissNotice_Click" Padding="7,0" BorderThickness="0" Background="Transparent"/><TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="#E5DCA8" VerticalAlignment="Center"/></DockPanel></Border>
   <TabControl x:Name="Pages" Grid.Row="2" BorderThickness="0" Background="Transparent"><TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
    <TabItem>
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <UniformGrid Columns="3" Margin="0,0,0,18">
       <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="REDIS 信令" FontSize="10" Foreground="#94A7AE"/><TextBlock x:Name="SignalStatusText" Text="未启动" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,7"/><TextBlock x:Name="SignalDetailText" MaxHeight="42" Text="只交换状态与连接信息" Style="{StaticResource Hint}"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="P2P 直连" FontSize="10" Foreground="#94A7AE"/><TextBlock x:Name="PeerCountText" Text="0 台" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,7" Foreground="#85E6C5"/><TextBlock x:Name="StreamsText" Text="0 条业务连接" Style="{StaticResource Hint}"/></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="实时传输" FontSize="10" Foreground="#94A7AE"/><TextBlock x:Name="RateText" Text="0 B/s" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,7"/><TextBlock x:Name="RateDetailText" Text="↑ 0 B/s    ↓ 0 B/s" Style="{StaticResource Hint}"/></StackPanel></Border>
      </UniformGrid>
      <DockPanel Grid.Row="1" Margin="0,4,0,13"><TextBlock Text="直连会话" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="RunModeText" DockPanel.Dock="Right" Text="托盘后台模式" Style="{StaticResource Hint}" HorizontalAlignment="Right"/></DockPanel>
      <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True"><Grid><DataGrid x:Name="PeersGrid" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="对端设备" Binding="{Binding Name}" Width="1.1*"/><DataGridTextColumn Header="连接状态" Binding="{Binding State}" Width="1.25*"/><DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="1*"/><DataGridTextColumn Header="延迟" Binding="{Binding Latency}" Width="80"/><DataGridTextColumn Header="TCP" Binding="{Binding Streams}" Width="50"/></DataGrid.Columns><DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="ToolTip" Value="{Binding Detail}"/></Style></DataGrid.RowStyle></DataGrid><StackPanel x:Name="EmptyPeers" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,38,0,0"><TextBlock Text="等待两端相遇" FontSize="20" HorizontalAlignment="Center" Foreground="#A5BCBD"/><TextBlock x:Name="EmptyPeerHint" Text="完成连接配置，再启动提供端和客户端。" Style="{StaticResource Hint}" Margin="0,9,0,0" HorizontalAlignment="Center"/></StackPanel></Grid></Border>
      <Border Grid.Row="3" Background="#132A2B" CornerRadius="8" Padding="16,12" Margin="0,16,0,0"><TextBlock Text="Redis 仅做信令。业务通过 ICE + QUIC 直接传输；无法直连时不会退回中转。" TextWrapping="Wrap" FontSize="12" Foreground="#A3C6BD" LineHeight="20"/></Border>
     </Grid>
    </TabItem>
    <TabItem>
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Margin="0,0,0,16">
       <TextBlock x:Name="ServiceHint" Style="{StaticResource Hint}" Text="发布本机或本机可访问的 TCP 服务。编辑后点击“保存并应用”。" Margin="0,0,0,14"/>
       <Grid x:Name="DiscoveryPanel" Visibility="Collapsed" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="DeviceCombo" DisplayMemberPath="Display" SelectionChanged="DeviceCombo_SelectionChanged" Margin="0,0,10,0" ToolTip="在线提供端（连接组一致）"/><ComboBox x:Name="ServiceCombo" Grid.Column="1" DisplayMemberPath="Display" Margin="0,0,10,0" ToolTip="提供端发布的服务"/><Button Grid.Column="2" Content="添加映射" Click="AddMapping_Click" Style="{StaticResource PrimaryButton}"/></Grid>
       <StackPanel Orientation="Horizontal"><Button x:Name="AddServiceButton" Content="＋ 添加服务" Click="AddService_Click" Margin="0,0,10,0"/><Button Content="删除所选" Click="DeleteRow_Click"/><TextBlock Text="勾选启用 · 双击单元格修改" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="16,0,0,0"/></StackPanel>
      </StackPanel>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><Grid>
       <DataGrid x:Name="ServicesGrid"><DataGrid.Columns><DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="58"/><DataGridTextColumn Header="服务名称" Binding="{Binding Name}" Width="1.2*"/><DataGridTextColumn Header="目标地址" Binding="{Binding Host}" Width="1.4*"/><DataGridTextColumn Header="目标端口" Binding="{Binding Port, ValidatesOnExceptions=True}" Width="100"/></DataGrid.Columns></DataGrid>
       <DataGrid x:Name="MappingsGrid" Visibility="Collapsed"><DataGrid.Columns><DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="55"/><DataGridTextColumn Header="服务名称" Binding="{Binding Name}" Width="1*"/><DataGridTextColumn Header="提供端" Binding="{Binding DeviceName}" IsReadOnly="True" Width="1*"/><DataGridTextColumn Header="本地 IP" Binding="{Binding LocalHost}" Width="125"/><DataGridTextColumn Header="本地端口" Binding="{Binding LocalPort, ValidatesOnExceptions=True}" Width="80"/><DataGridTextColumn Header="最近结果" Binding="{Binding RuntimeStatus}" IsReadOnly="True" Width="110"/></DataGrid.Columns><DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="ToolTip" Value="{Binding RuntimeError}"/></Style></DataGrid.RowStyle></DataGrid>
      </Grid></Border>
      <DockPanel Grid.Row="2" Margin="0,16,0,0"><Button Content="保存并应用" Style="{StaticResource PrimaryButton}" Click="Save_Click" DockPanel.Dock="Right"/><TextBlock x:Name="MappingFooter" Style="{StaticResource Hint}" Text="应用修改会重新建立连接，正在使用的会话会断开。" VerticalAlignment="Center" Margin="0,0,15,0"/></DockPanel>
     </Grid>
    </TabItem>
    <TabItem>
     <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0"><StackPanel>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Redis 信令" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="两端填写同一实例、数据库和连接组。" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
         <TextBlock Text="主机地址" Style="{StaticResource Label}"/><TextBox x:Name="RedisHostBox" ToolTip="只填写域名或 IP，不带 redis://"/>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="端口" Style="{StaticResource Label}"/><TextBox x:Name="RedisPortBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="数据库 DB" Style="{StaticResource Label}"/><TextBox x:Name="RedisDbBox"/></StackPanel></Grid>
         <TextBlock Text="用户名（可留空）" Style="{StaticResource Label}"/><TextBox x:Name="RedisUserBox"/><TextBlock Text="密码" Style="{StaticResource Label}"/><PasswordBox x:Name="RedisPasswordBox"/><CheckBox x:Name="RedisTlsCheck" Content="Redis 使用 TLS" Margin="0,13,0,0"/>
        </StackPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="设备与启动" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="设备 ID 自动生成，不需要手动配对。" Style="{StaticResource Hint}" Margin="0,8,0,0"/><TextBlock Text="设备名称" Style="{StaticResource Label}"/><TextBox x:Name="DeviceNameBox"/><TextBlock Text="连接组" Style="{StaticResource Label}"/><TextBox x:Name="GroupBox"/><TextBlock Text="直连超时（10–120 秒）" Style="{StaticResource Label}"/><TextBox x:Name="TimeoutBox"/><CheckBox x:Name="AutoConnectCheck" Content="软件启动后自动连接" Margin="0,17,0,3"/><CheckBox x:Name="StartupCheck" Content="登录 Windows 时启动并隐藏到托盘"/><TextBlock x:Name="DeviceIdText" Style="{StaticResource Hint}" FontFamily="Consolas" FontSize="10" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Border>
       </Grid>
       <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="STUN 地址发现" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="每行一个 UDP STUN 地址。按列表提供候选，多个节点并行收集，避免故障节点阻塞直连；不会使用 TURN。" Style="{StaticResource Hint}" Margin="0,8,0,12"/><TextBox x:Name="StunBox" AcceptsReturn="True" MinHeight="113" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="恢复默认 STUN" Click="ResetStun_Click"/><Button Content="放行程序 UDP（管理员）" Click="Firewall_Click" Margin="10,0,0,0"/></StackPanel></StackPanel></Border>
       <Border x:Name="ServiceModePanel" Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel><TextBlock Text="无人值守运行" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="将提供端核心注册为 Windows 服务，未登录也可上线。安装后请勿移动或删除程序目录。配置仍可在此界面修改。" Style="{StaticResource Hint}" Margin="0,8,0,12"/><WrapPanel><Button x:Name="InstallServiceButton" Content="安装并启动服务" Click="InstallService_Click" Margin="0,0,9,8"/><Button x:Name="StartServiceButton" Content="启动服务" Click="StartService_Click" Margin="0,0,9,8"/><Button x:Name="RemoveServiceButton" Content="移除服务" Click="RemoveService_Click" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="ServiceModeHint" Style="{StaticResource Hint}"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Margin="0,16,0,16"><StackPanel><TextBlock Text="配置与文件" FontSize="16" FontWeight="SemiBold"/><WrapPanel Margin="0,13,0,0"><Button Content="导入配置" Click="Import_Click" Margin="0,0,10,8"/><Button Content="导出配置" Click="Export_Click" Margin="0,0,10,8"/><Button Content="打开配置目录" Click="OpenConfigFolder_Click" Margin="0,0,0,8"/></WrapPanel><TextBlock Text="配置保存在当前用户的 LocalAppData\NorthLink。导出配置包含 Redis 密码，请勿发到公开位置。" Style="{StaticResource Hint}"/></StackPanel></Border>
      </StackPanel></ScrollViewer>
      <DockPanel Grid.Row="1" Margin="0,14,0,0"><Button Content="保存并应用" Click="Save_Click" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right"/><TextBlock Text="修改网络配置会断开现有会话，并按当前运行状态重新连接。" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,15,0"/></DockPanel>
     </Grid>
    </TabItem>
    <TabItem>
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,15"><Button Content="导出日志" Click="ExportLogs_Click" DockPanel.Dock="Right"/><TextBlock Text="最近 250 条事件 · 区分信令、直连与目标服务错误" Style="{StaticResource Hint}" VerticalAlignment="Center"/></DockPanel><Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="LogsGrid" IsReadOnly="True" RowHeight="Auto"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="85"/><DataGridTextColumn Header="级别" Binding="{Binding LevelText}" Width="62"/><DataGridTextColumn Header="事件" Binding="{Binding Message}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="21"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid></Border><TextBlock Grid.Row="2" Text="无法直连时请检查 UDP、防火墙、两端网络，以及 STUN 可达性；不是所有 NAT 组合都能打洞。" Style="{StaticResource Hint}" Margin="0,13,0,0"/></Grid>
    </TabItem>
   </TabControl>
   <DockPanel Grid.Row="3" Margin="0,16,0,0"><TextBlock x:Name="FooterStatus" Text="正在连接本机网络核心…" FontSize="11" Foreground="#829BA4"/><TextBlock Text="关闭窗口将隐藏到托盘" FontSize="11" Foreground="#829BA4" HorizontalAlignment="Right"/></DockPanel>
  </Grid>
 </Grid>
</Window>
